# Required on Vercel. Leave all three unset for local dev: the process
# generates an ephemeral RSA keypair and uses the password local-dev-password.
#
# PEM values can be pasted with real line breaks, or as a single line with \n.
# RSA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# RSA_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
# AUTH_PASSWORD="replace-me"

# Token max age in milliseconds. Default is 500.
# Raise this if HTTPS latency or a Vercel cold start rejects fresh tokens.
# MAX_TOKEN_AGE_MS=500
